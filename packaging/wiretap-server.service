[Unit]
Description=WireTAP capture server — SocketCAN to GVRET, archived to a gateway
Documentation=https://github.com/Wired-Square/WireTAP-Server
# Not Requires=, and not network-online.target. Capture is the job; the gateway
# is where frames go afterwards, and a gateway that is unreachable at boot is
# what the disk cache exists for. Waiting for the network would only delay the
# one thing that cannot be caught up later.
After=network.target

[Service]
# Active once the archives, the devices and the listeners are up, not at the
# exec, so `systemctl start` waits for that and fails on a refused start.
Type=notify
# The config file is named explicitly because the daemon has no default path
# for one — it reads a config only when passed -C, exactly as the Python did. It
# may be absent: the daemon then runs on its defaults. Everything else stays out
# of this file: the unit ships inside the package and is replaced on every
# upgrade, so an edit here is lost silently, where
# /etc/wiretap-server/wiretap-server.toml is never overwritten once it has
# something in it.
#
# Note the precedence, which is the Python's and is the opposite of most
# daemons': the FILE overrides the command line, and both override what the web
# UI sets in $STATE_DIRECTORY/ui.toml. To see what actually results, and where
# each setting comes from, with the state directory this unit gives it:
#
#     STATE_DIRECTORY=/var/lib/wiretap-server \
#         wiretap-server --check-config -C /etc/wiretap-server/wiretap-server.toml
ExecStart=/usr/bin/wiretap-server -C /etc/wiretap-server/wiretap-server.toml

User=wiretap
Group=wiretap

# Port 23 is GVRET's default and is privileged. Nothing else here needs a
# capability: an AF_CAN raw socket does not require CAP_NET_RAW — which is why
# candump runs as an ordinary user — and the netlink bitrate query needs none
# either. A deployment on a high port can drop this line entirely.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# systemd creates and owns this, so the daemon never has to mkdir. The disk
# cache lives here: $STATE_DIRECTORY is what the daemon defaults cache_path
# from, so the path is declared once rather than here and again in the config.
StateDirectory=wiretap-server
StateDirectoryMode=0700
ConfigurationDirectory=wiretap-server
# The control socket, $RUNTIME_DIRECTORY/control.sock, mode 0660 in this unit's
# group. Its permissions are its only authentication: anyone in the group can
# change what the web UI can. 0750 keeps everyone else from reaching it.
RuntimeDirectory=wiretap-server
RuntimeDirectoryMode=0750

# The shutdown flush is what empties the batcher into the gateway or the cache,
# and a full queue at 50 000 frames is not instant. The default 90 s would do;
# 30 s says the number was chosen.
TimeoutStopSec=30

# A capture that stops is a capture with a hole in it. After the web UI changes
# a setting the daemon flushes as for systemctl stop and executes itself again;
# only if that fails does it exit 75, for this to start it on the change.
Restart=always
SuccessExitStatus=75
RestartSec=15s
# A device absent at boot is waited for, but a refused open (a permission, a
# missing module) fails every start until fixed; one a minute is enough to
# notice it, and the cap bounds the hole a real crash leaves. These two need
# systemd 254: bookworm's 252 ignores them and retries every RestartSec.
RestartSteps=5
RestartMaxDelaySec=60s
# Pinged every 15 s from the runtime, through a slow start, a gateway outage
# and the shutdown flush, so only a wedged daemon misses two; it is restarted
# as for a crash.
WatchdogSec=30s

# Hardening. The daemon reads CAN sockets and serial lines, writes SQLite
# files, and talks to a gateway over TCP; it has no business doing anything
# else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# SocketCAN is a network protocol family, not a device node; a serial tap is
# one. The daemon may read a USB serial adapter and nothing else under /dev —
# read-only, so a tap cannot transmit however it is configured. A char-
# group is resolved when the unit starts: with no adapter ever plugged in,
# the driver is not loaded and the allow is dropped in silence.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-ttyUSB r
DeviceAllow=char-ttyACM r
SupplementaryGroups=dialout
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
# AF_CAN is the capture itself. AF_NETLINK is not optional and is the classic
# omission: the bitrate query that replaced pyroute2 goes through it, and
# without it every interface reports the 500 kbit/s fallback instead of what it
# is actually configured for. AF_INET/AF_INET6 are the GVRET listener, the
# ingest listener and the forward link; AF_UNIX is journald.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_CAN

# Optional, and where the gateway API key and the ingest token belong —
# WIRETAP_FORWARD_TOKEN and WIRETAP_INGEST_TOKEN — rather than in a config file
# that is world-readable.
EnvironmentFile=-/etc/wiretap-server/env

[Install]
WantedBy=multi-user.target
