#!/bin/sh
set -e

USER=wiretap
CONFIG_DIR=/etc/wiretap-server
STATE_DIR=/var/lib/wiretap-server
UNIT=wiretap-server.service
JOURNALD_DROPIN=/etc/systemd/journald.conf.d/95-wiretap-persistent.conf

# Spelled as in the postinst, which make-deb.sh already keeps this script in
# step with on every path they share.
say() { echo "wiretap-server: $*"; }

case "$1" in
    remove)
        rm -f "$JOURNALD_DROPIN"
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper mask "$UNIT" >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl restart systemd-journald >/dev/null 2>&1 || true
        fi
        ;;

    purge)
        rm -f "$JOURNALD_DROPIN"
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper purge "$UNIT" >/dev/null 2>&1 || true
            deb-systemd-helper unmask "$UNIT" >/dev/null 2>&1 || true
        fi

        # The configuration, and the environment file with the gateway API key
        # in it. Purge means purge, so they go.
        if [ -d "$CONFIG_DIR" ]; then
            say "removing $CONFIG_DIR (configuration, and any"
            say "  environment file holding the gateway API key)"
            rm -rf "$CONFIG_DIR"
        fi

        # A state directory with anything in it is NOT removed, against Debian
        # convention. It holds the disk cache, and that cache is only ever
        # non-empty when it is carrying captured frames that never reached the
        # gateway. Losing those to an apt command is worse than an orphaned
        # directory - and this is exactly the moment somebody is removing a
        # package because something is already wrong.
        #
        # The account stays with them. dpkg reserves no uid, so deleting the
        # owner while keeping the files is what strands a capture: the next
        # install is given whatever uid is free and inherits a cache it cannot
        # write. Leaving a system account behind is the ordinary Debian answer
        # anyway - nothing asks a package to delete one, for this exact reason.
        #
        # `rmdir` is the test, not `[ -d ]`: the question is whether there is a
        # capture to keep, and a host that installed this and never ran it has
        # an empty directory that should simply go. It fails harmlessly when
        # there is something inside, and succeeds only when there was not.
        if [ -d "$STATE_DIR" ] && ! rmdir "$STATE_DIR" 2>/dev/null; then
            say "$STATE_DIR kept, and the $USER account with it: cache.db holds"
            say "  captured frames that never reached the gateway. To remove both,"
            say "  rm -rf $STATE_DIR && deluser --system $USER"
        else
            if getent passwd "$USER" >/dev/null 2>&1; then
                deluser --quiet --system "$USER" >/dev/null 2>&1 \
                    || userdel "$USER" >/dev/null 2>&1 || true
            fi
            if getent group "$USER" >/dev/null 2>&1; then
                delgroup --quiet --system "$USER" >/dev/null 2>&1 \
                    || groupdel "$USER" >/dev/null 2>&1 || true
            fi
        fi

        # /var/log/journal is not removed either: it holds the record of this
        # removal, and of whatever the capture was doing beforehand. Deleting
        # logs as a side effect of removing a package is backwards.
        ;;
esac

exit 0
