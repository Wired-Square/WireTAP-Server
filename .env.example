# Copy to .env (git-ignored) and fill in, or mount it from 1Password, with
# per-machine overrides in .env.local: one bare KEY=value per line, read as
# written and never sourced. The environment wins over both.

# apps/make-source.sh: the source's name as a box holds its root (default
# wiretap), and an OpenSSL 3 when the one on PATH is not.
SOURCE=
OPENSSL=

# apps/check-source.sh: the ApplianceOS commit to check against (default HEAD).
APPLIANCEOS_REV=
